[Unit]
Description=Iris host daemon (portunus)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/iris-host
Restart=on-failure
RestartSec=3
Environment=IRIS_LITELLM=0
# Pool mode may set IRIS_LITELLM=1; LiteLLM must bind 127.0.0.1 only.

[Install]
WantedBy=default.target
