<?xml version="1.0" encoding="UTF-8"?>
<!-- Iris tray MSI skeleton (WiX). Real candle/light build is maintainer-local. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Iris" Language="1033" Version="0.0.0" Manufacturer="edwardlthompson" UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" />
    <Feature Id="Tray" Title="Iris host tray" Level="1">
      <ComponentRef Id="TrayExe" />
    </Feature>
    <Feature Id="LiteLLM" Title="Optional LiteLLM (pool mode)" Level="1000">
      <ComponentRef Id="LiteLlmOpt" />
    </Feature>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="IrisDir" Name="Iris">
          <Component Id="TrayExe" Guid="*">
            <File Id="IrisTray" Source="iris-tray.exe" KeyPath="yes" />
          </Component>
          <Component Id="LiteLlmOpt" Guid="*">
            <File Id="LiteLlmMarker" Source="litellm.optional.txt" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>
  </Product>
</Wix>
