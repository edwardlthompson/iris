{
  "name": "iris",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Self-hosted phone remote for coding agents, with cost-aware routing",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
